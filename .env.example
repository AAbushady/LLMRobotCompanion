# LLM Robot Companion configuration
# Copy to .env and fill in your values.
# Priority: environment variables > .env file > hardcoded defaults

# ---------------------------------------------------------------------------
# Backend selection: "claude" or "openai"
# ---------------------------------------------------------------------------
LLM_BACKEND=openai

# ---------------------------------------------------------------------------
# Claude backend (direct Anthropic API)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ---------------------------------------------------------------------------
# OpenAI-compatible backend (OpenRouter, Aphrodite, vLLM, etc.)
# ---------------------------------------------------------------------------
OPENAI_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENAI_API_KEY=sk-or-...
OPENAI_MODEL=anthropic/claude-sonnet-4

# ---------------------------------------------------------------------------
# Summarizer overrides (optional — falls back to main backend if not set)
# Set just SUMMARIZER_MODEL for a cheaper model on the same endpoint,
# or set SUMMARIZER_BACKEND + SUMMARIZER_API_URL for a different server.
# ---------------------------------------------------------------------------
# SUMMARIZER_BACKEND=
# SUMMARIZER_API_URL=
# SUMMARIZER_API_KEY=
# SUMMARIZER_MODEL=anthropic/claude-haiku
